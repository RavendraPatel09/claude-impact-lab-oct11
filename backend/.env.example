APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000
HOST=0.0.0.0
SOURCE_VERSION=2025-03-06
# Optional path to rules JSONL if running from a different root
RULES_DATA_PATH=../track-1-bhumi-vikas-sahayak/data/bhumi_vikas_rules.jsonl

# Optional: multilingual embedding model used for semantic retrieval.
# If sentence-transformers/faiss-cpu aren't installed, or this fails to
# load, retrieval silently degrades to keyword-only search.
SEMANTIC_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional: enables LLM-grounded answer generation for questions outside the
# hand-verified sample set. Leave blank to keep the deterministic,
# zero-API-key fallback (top retrieved passage + excerpt).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
